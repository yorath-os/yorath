# Worker node gateway (change cluster-nodes). No TLS needed: :8090 is published only on the node address in
# the WireGuard tunnel, which encrypts traffic and admits only peers with a key.
{
	admin off
	auto_https off
}

# entry from the main node: the node's model servers and the entry points of the node's connected agents
:8090 {
	@foreign not remote_ip {$YORATH_MAIN_IP:10.88.0.1}
	respond @foreign 403

	# /ollama/<model server>/...: one Ollama per card (installer/node-models.sh); the name is limited to
	# the node's own model servers, so the path cannot reach any other container
	@ollama path_regexp ollama ^/ollama/(cpu|gpu[0-9]{1,2})(/.*)$
	handle @ollama {
		rewrite * {re.ollama.2}
		reverse_proxy ollama-{re.ollama.1}:11434 {
			flush_interval -1
		}
	}

	# /agents/172.31.0.<n>:<port>/... is limited to the node agents network
	@agent path_regexp agent ^/agents/(172\.31\.0\.[0-9]{1,3}):([0-9]{2,5})(/.*)$
	handle @agent {
		rewrite * {re.agent.3}
		# no X-Forwarded-*: with them OpenClaw requires gateway.trustedProxies and answers 403
		# (cluster bench 13.11.2026); the agent's client is the gateway, and the entry is behind a token anyway
		reverse_proxy {re.agent.1}:{re.agent.2} {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			flush_interval -1
		}
	}

	respond 404
}

# for node agents this is core:8000: the model only through the main node Gateway, with their key
:8000 {
	reverse_proxy {$YORATH_MAIN_IP:10.88.0.1}:8000 {
		flush_interval -1
	}
}
