# Generated by `make render-env` from distribution.yaml; edit the manifest, not this file.
# Variables below can be overridden in .env.local (ports, passwords).
YORATH_DB_PASSWORD=yorath
YORATH_WEB_BIND=127.0.0.1
YORATH_WEB_PORT=8080
# Generated by install.sh (Fernet key, one-time wizard code, node GPU):
# YORATH_SECRET_KEY=
# YORATH_SETUP_CODE=
# YORATH_GPU_NAME=
# YORATH_GPU_VRAM_GB=
# YORATH_GPU_COUNT=

# Locally (make up) TLS is not needed: the panel is on 127.0.0.1. On a server install.sh turns TLS on.
YORATH_TLS=off
